<!-- Login Modal -->
<div class="modal fade"
     id="loginModal"
     tabindex="-1"
     aria-labelledby="loginModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header border-0">

                <h5 class="modal-title fw-bold" id="loginModalLabel">
                    프로젝트 체험
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body text-center py-4">

                <p class="text-muted mb-4">
                    서비스 상세 기능을 확인하려면 로그인이 필요합니다.
                </p>

                <div class="d-grid gap-3 px-4">

                    <a href="/oauth2/authorization/google"
                       class="btn btn-outline-dark btn-lg">

                        <i class="fab fa-google me-2"></i>
                        Google
                    </a>

                    <a href="/oauth2/authorization/naver"
                       class="btn btn-outline-success btn-lg">

                        <i class="fas fa-n me-2"></i>
                        Naver
                    </a>

                    <hr class="my-2">

                    <form action="/login/demo" method="post">

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">

                            <i class="fas fa-user-secret me-2"></i>
                            데모 계정으로 체험하기

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

    function checkLoginAndRedirect(url, isLoggedIn) {

        if (isLoggedIn) {

            // 로그인 상태면 해당 페이지 또는 외부 URL로 이동
            location.href = url;

        } else {

            // 로그인하지 않은 경우 로그인 모달 표시
            var loginModal =
                    new bootstrap.Modal(
                            document.getElementById('loginModal')
                    );

            loginModal.show();
        }
    }

</script>

